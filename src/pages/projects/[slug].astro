---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import RichText from "../../components/RichText.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project }
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const baseUrl = import.meta.env.BASE_URL;
const blocks = project.data.blocks ?? [];
const hasSupplementaryContent = Boolean(project.body?.trim());

const heroImages = project.data.heroGallery?.length
  ? project.data.heroGallery
  : project.data.gallery?.length
    ? project.data.gallery.map((src) => ({ src, alt: project.data.title }))
    : project.data.cover
      ? [{ src: project.data.cover, alt: project.data.title }]
      : [];

function getImageGridColumnClass(imageCount) {
  if (imageCount >= 4) return "col-lg-3 col-md-6";
  if (imageCount === 3) return "col-lg-4 col-md-6";
  if (imageCount === 2) return "col-lg-6";
  return "col-12";
}

function getTwoColumnClasses(layout = "1-1") {
  if (layout === "1-2") {
    return { left: "col-lg-4", right: "col-lg-8" };
  }
  if (layout === "2-1") {
    return { left: "col-lg-8", right: "col-lg-4" };
  }
  return { left: "col-lg-6", right: "col-lg-6" };
}

function getContentImageStyle(maxWidth) {
  const resolvedMaxWidth = maxWidth || "88%";
  return `width: 100%; max-width: ${resolvedMaxWidth}; margin: 0 auto; display: block; cursor: zoom-in;`;
}

function hasBlockTitle(block) {
  return typeof block.title === "string" && block.title.trim().length > 0;
}

function getBlockProse(block) {
  if (block.type === "paragraph" || block.type === "quote") {
    return [...(block.paragraphs ?? []), block.text ?? ""];
  }

  if (block.type === "two-column") {
    return [block.left, block.right]
      .filter((column) => column.kind === "text")
      .flatMap((column) => [...(column.paragraphs ?? []), column.text ?? ""]);
  }

  return [];
}

function hasSubheading(block) {
  return getBlockProse(block).some((text) => /<h5\b/i.test(text));
}

function isMediaBlock(block) {
  return block.type === "image" || block.type === "image-grid";
}

function isDisclaimer(block) {
  return getBlockProse(block).some((text) => /<strong>\s*Disclaimer:\s*<\/strong>/i.test(text));
}

function getAssetUrl(src) {
  return `${baseUrl}${src}`;
}
---

<BaseLayout title={`${project.data.title} - Portfolio`} description={project.data.summary}>
  <SiteHeader active="portfolio" />

  <main id="main">
    <>
          <section class="breadcrumbs">
            <div class="container">
              <div class="d-flex justify-content-between align-items-center">
                <h2>Portfolio Details</h2>
                <ol>
                  <li><a href={baseUrl}>Home</a></li>
                  <li><a href={`${baseUrl}#portfolio`}>Portfolio</a></li>
                  <li>Portfolio Details - {project.data.title}</li>
                </ol>
              </div>
            </div>
          </section>

          <section id="portfolio-details" class="portfolio-details">
            <div class="container">
              <div class="row gy-4">
                <div class="col-lg-8">
                  {
                    heroImages.length ? (
                      <div class="portfolio-details-slider swiper-container">
                        <div class="swiper-wrapper align-items-center">
                          {
                            heroImages.map((image) => (
                              <div class="swiper-slide">
                                <img src={getAssetUrl(image.src)} alt={image.alt || project.data.title} />
                              </div>
                            ))
                          }
                        </div>
                        <div class="swiper-pagination"></div>
                      </div>
                    ) : null
                  }
                </div>

                <div class="col-lg-4">
                  <br />
                  <h1>{project.data.title}</h1>
                  <br />

                  <div class="portfolio-info">
                    <h3>Project information</h3>
                    <ul>
                      <li><strong>Category</strong>: {project.data.category}</li>
                      {project.data.timeline ? <li><strong>Timeline</strong>: {project.data.timeline}</li> : null}
                      {project.data.client || project.data.info?.client ? <li><strong>Client</strong>: {project.data.client || project.data.info?.client}</li> : null}
                      {project.data.teamMembers || project.data.info?.teamMembers ? <li><strong>Team members</strong>: {project.data.teamMembers || project.data.info?.teamMembers}</li> : null}
                      {project.data.position || project.data.info?.role ? <li><strong>Position</strong>: {project.data.position || project.data.info?.role}</li> : null}
                      {project.data.price || project.data.info?.price ? <li><strong>Price</strong>: {project.data.price || project.data.info?.price}</li> : null}
                      {project.data.tools || project.data.info?.tools ? <li><strong>Developing Tools</strong>: {project.data.tools || project.data.info?.tools}</li> : null}
                      {
                        project.data.websiteUrl ? (
                          <li>
                            <strong>Website</strong>: <a href={project.data.websiteUrl} target="_blank" rel="noreferrer">{project.data.websiteLabel || project.data.websiteUrl}</a>
                          </li>
                        ) : null
                      }
                      {
                        project.data.videoUrl ? (
                          <li>
                            <strong>Video Link</strong>: <a href={project.data.videoUrl} target="_blank" rel="noreferrer">{project.data.videoLabel || project.data.videoUrl}</a>
                          </li>
                        ) : null
                      }
                    </ul>
                  </div>
                </div>
              </div>

              {
                blocks.map((block, index) => (
                  <div
                    class={`row project-block${index === 0 ? " project-block--first" : ""}${index > 0 ? " project-block--after" : ""}${isMediaBlock(block) ? " project-block--media" : ""}${block.type === "embed" ? " project-block--embed" : ""}${hasBlockTitle(block) && index > 0 ? " project-block--section" : ""}${index > 0 && isMediaBlock(blocks[index - 1]) && hasSubheading(block) ? " project-block--subheading-after-media" : ""}${isDisclaimer(block) ? " project-block--disclaimer" : ""}`}
                  >
                    <div class="col-12 col-lg-10 offset-lg-1 descrip-section" style="padding-top: 0; padding-bottom: 0;">
                      {block.title ? <h2 class="project-block__title">{block.title}</h2> : null}

                      {block.type === "paragraph" ? <RichText text={block.text} paragraphs={block.paragraphs} /> : null}

                      {
                        block.type === "image" ? (
                          <div>
                            <a href={getAssetUrl(block.image.src)} data-glightbox="single" style="display:block;cursor:zoom-in;">
                              <img
                                src={getAssetUrl(block.image.src)}
                                alt={block.image.alt || project.data.title}
                                style={getContentImageStyle(block.image.maxWidth)}
                              />
                            </a>
                            {block.image.caption ? <p class="project-image-caption">{block.image.caption}</p> : null}
                          </div>
                        ) : null
                      }

                      {
                        block.type === "image-grid" ? (
                          <div class="row" style="--bs-gutter-x: 2.75rem; --bs-gutter-y: 0;">
                            {
                              block.images.map((image) => (
                                <div class={getImageGridColumnClass(block.images.length)}>
                                  <a href={getAssetUrl(image.src)} data-glightbox="single" style="display:block;cursor:zoom-in;">
                                    <img
                                      src={getAssetUrl(image.src)}
                                      alt={image.alt || project.data.title}
                                      style={getContentImageStyle(image.maxWidth)}
                                    />
                                  </a>
                                  {image.caption ? <p class="project-image-caption">{image.caption}</p> : null}
                                </div>
                              ))
                            }
                          </div>
                        ) : null
                      }

                      {
                        block.type === "two-column" ? (
                          <div class="row gy-4">
                            <div class={getTwoColumnClasses(block.layout).left}>
                              {
                                block.left.kind === "text"
                                  ? <RichText text={block.left.text} paragraphs={block.left.paragraphs} />
                                  : block.left.kind === "image-grid" ? (
                                    <div class="row" style="--bs-gutter-x: 1.75rem; --bs-gutter-y: 0;">
                                      {block.left.images.map((image) => (
                                        <div class={getImageGridColumnClass(block.left.images.length)}>
                                          <a href={getAssetUrl(image.src)} data-glightbox="single" style="display:block;cursor:zoom-in;">
                                            <img src={getAssetUrl(image.src)} alt={image.alt || project.data.title} style={getContentImageStyle(image.maxWidth)} />
                                          </a>
                                          {image.caption ? <p class="project-image-caption">{image.caption}</p> : null}
                                        </div>
                                      ))}
                                    </div>
                                  ) : (
                                    <>
                                      <a href={getAssetUrl(block.left.image.src)} data-glightbox="single" style="display:block;cursor:zoom-in;">
                                        <img src={getAssetUrl(block.left.image.src)} alt={block.left.image.alt || project.data.title} style={getContentImageStyle(block.left.image.maxWidth)} />
                                      </a>
                                      {block.left.image.caption ? <p class="project-image-caption">{block.left.image.caption}</p> : null}
                                    </>
                                  )
                              }
                            </div>
                            <div class={getTwoColumnClasses(block.layout).right}>
                              {
                                block.right.kind === "text"
                                  ? <RichText text={block.right.text} paragraphs={block.right.paragraphs} />
                                  : block.right.kind === "image-grid" ? (
                                    <div class="row" style="--bs-gutter-x: 1.75rem; --bs-gutter-y: 0;">
                                      {block.right.images.map((image) => (
                                        <div class={getImageGridColumnClass(block.right.images.length)}>
                                          <a href={getAssetUrl(image.src)} data-glightbox="single" style="display:block;cursor:zoom-in;">
                                            <img src={getAssetUrl(image.src)} alt={image.alt || project.data.title} style={getContentImageStyle(image.maxWidth)} />
                                          </a>
                                          {image.caption ? <p class="project-image-caption">{image.caption}</p> : null}
                                        </div>
                                      ))}
                                    </div>
                                  ) : (
                                    <>
                                      <a href={getAssetUrl(block.right.image.src)} data-glightbox="single" style="display:block;cursor:zoom-in;">
                                        <img src={getAssetUrl(block.right.image.src)} alt={block.right.image.alt || project.data.title} style={getContentImageStyle(block.right.image.maxWidth)} />
                                      </a>
                                      {block.right.image.caption ? <p class="project-image-caption">{block.right.image.caption}</p> : null}
                                    </>
                                  )
                              }
                            </div>
                          </div>
                        ) : null
                      }

                      {
                        block.type === "quote" ? (
                          <blockquote style="border-left: 4px solid #20b38e; padding-left: 1rem; color: #444;">
                            <RichText text={block.text} paragraphs={block.paragraphs} />
                            {block.author ? <cite>{block.author}</cite> : null}
                          </blockquote>
                        ) : null
                      }

                      {
                        block.type === "embed" ? (
                          <div>
                            <div style="display: flex; justify-content: center; margin-top: 24px;">
                              <iframe
                                src={block.src}
                                width={block.width || "1000"}
                                height={block.height || "600"}
                                style="border: 1px solid rgba(0, 0, 0, 0.1); max-width: 100%;"
                                allowfullscreen
                              ></iframe>
                            </div>

                            {block.caption ? <p class="project-image-caption">{block.caption}</p> : null}
                          </div>
                        ) : null
                      }
                    </div>
                  </div>
                ))
              }

              {
                hasSupplementaryContent ? (
                  <div class="row">
                    <div class="col-12 col-lg-10 offset-lg-1 descrip-section">
                      <Content />
                    </div>
                  </div>
                ) : null
              }
            </div>
          </section>
    </>
  </main>

  <SiteFooter />

<style is:inline>
  .project-block--first {
    margin-top: 3rem;
  }

  .project-block--after {
    margin-top: 1.5rem;
  }

  .project-block--media {
    margin-top: 2rem;
  }

  .project-block--media + .project-block {
    margin-top: 2rem;
  }

  .project-block--media + .project-block--section {
    margin-top: 5rem;
  }

  .project-block--media + .project-block--subheading-after-media {
    margin-top: 4rem;
  }

  .project-block--media .descrip-section img {
    padding-top: 0;
  }

  .project-block .descrip-section > p:first-child {
    padding-top: 0;
  }

  .project-block .descrip-section > :last-child {
    margin-bottom: 0;
  }

  .project-image-caption {
    margin: 0.5rem 0 0;
    padding-top: 0 !important;
    color: #666;
    text-align: center;
    line-height: 1.4;
  }

  .project-block--section {
    margin-top: 5rem;
  }

  .project-block--subheading-after-media {
    margin-top: 4rem;
  }

  .project-block--disclaimer {
    margin-top: 5rem;
  }

  .project-block--embed {
    margin-top: 2.5rem;
  }

  .project-block--embed.project-block--section {
    margin-top: 5rem;
  }

  .project-block__title {
    margin: 0 0 0.75rem;
  }

  /* 强化关闭按钮，超大X、清晰可见 */
  .glightbox-clean .gslide-close {
    font-size: 32px !important;
    width: 50px !important;
    height: 50px !important;
    line-height: 50px !important;
    background: rgba(0,0,0,0.55) !important;
    border-radius: 50% !important;
    top: 15px !important;
    right: 15px !important;
    color: #fff !important;
    z-index: 99999 !important;
  }
</style>

<script is:inline>
document.addEventListener('DOMContentLoaded', function(){
  if(typeof GLightbox === 'undefined') return;

  const lightbox = GLightbox({
    selector: '[data-glightbox="single"]',
    touchNavigation: false,
    loop: false,
    closeOnOutsideClick: true,
    closeOnEscape: true,
    closeButton: true,
    keyboardNavigation: false,
    skin: "clean"
  });
});
</script>

</BaseLayout>
