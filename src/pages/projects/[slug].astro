---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import RichText from "../../components/RichText.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project }
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const baseUrl = import.meta.env.BASE_URL;
const blocks = project.data.blocks ?? [];
const hasSupplementaryContent = Boolean(project.body?.trim());

const heroImages = project.data.heroGallery?.length
  ? project.data.heroGallery
  : project.data.gallery?.length
    ? project.data.gallery.map((src) => ({ src, alt: project.data.title }))
    : project.data.cover
      ? [{ src: project.data.cover, alt: project.data.title }]
      : [];

function getImageGridColumnClass(imageCount) {
  if (imageCount >= 4) return "col-lg-3 col-md-6";
  if (imageCount === 3) return "col-lg-4 col-md-6";
  if (imageCount === 2) return "col-lg-6";
  return "col-12";
}

function getTwoColumnClasses(layout = "1-1") {
  if (layout === "1-2") {
    return { left: "col-lg-4", right: "col-lg-8" };
  }
  if (layout === "2-1") {
    return { left: "col-lg-8", right: "col-lg-4" };
  }
  return { left: "col-lg-6", right: "col-lg-6" };
}

function getContentImageStyle(maxWidth) {
  const resolvedMaxWidth = maxWidth || "88%";
  return `width: 100%; max-width: ${resolvedMaxWidth}; margin: 0 auto; display: block; cursor: zoom-in;`;
}

function hasBlockTitle(block) {
  return typeof block.title === "string" && block.title.trim().length > 0;
}

function getBlockProse(block) {
  if (block.type === "paragraph" || block.type === "quote") {
    return [...(block.paragraphs ?? []), block.text ?? ""];
  }

  if (block.type === "two-column") {
    return [block.left, block.right]
      .filter((column) => column.kind === "text")
      .flatMap((column) => [...(column.paragraphs ?? []), column.text ?? ""]);
  }

  return [];
}

function hasSubheading(block) {
  return getBlockProse(block).some((text) => /<h5\b/i.test(text));
}

function isMediaBlock(block) {
  return block.type === "image" || block.type === "image-grid";
}

function isDisclaimer(block) {
  return getBlockProse(block).some((text) => /<strong>\s*Disclaimer:\s*<\/strong>/i.test(text));
}

function getAssetUrl(src) {
  return `${baseUrl}${src}`;
}
---

<BaseLayout title={`${project.data.title} - Portfolio`} description={project.data.summary}>
  <SiteHeader active="portfolio" />

  <main id="main">
    <>
          <section class="breadcrumbs">
            <div class="container">
              <div class="d-flex justify-content-between align-items-center">
                <h2>Portfolio Details</h2>
                <ol>
                  <li><a href={baseUrl}>Home</a></li>
                  <li><a href={`${baseUrl}#portfolio`}>Portfolio</a></li>
                  <li>Portfolio Details - {project.data.title}</li>
                </ol>
              </div>
            </div>
          </section>

          <section id="portfolio-details" class="portfolio-details">
            <div class="container">
              <div class="row gy-4">
                <div class="col-lg-8">
                  {
                    heroImages.length ? (
                      <div class="portfolio-details-slider swiper-container">
                        <div class="swiper-wrapper align-items-center">
                          {
                            heroImages.map((image) => (
                              <div class="swiper-slide">
                                <img src={getAssetUrl(image.src)} alt={image.alt || project.data.title} />
                              </div>
                            ))
                          }
                        </div>
                        <div class="swiper-pagination"></div>
                      </div>
                    ) : null
                  }
                </div>

                <div class="col-lg-4">
                  <br />
                  <h1>{project.data.title}</h1>
                  <br />

                  <div class="portfolio-info">
                    <h3>Project information</h3>
                    <ul>
                      <li><strong>Category</strong>: {project.data.category}</li>
                      {project.data.timeline ? <li><strong>Timeline</strong>: {project.data.timeline}</li> : null}
                      {project.data.client || project.data.info?.client ? <li><strong>Client</strong>: {project.data.client || project.data.info?.client}</li> : null}
                      {project.data.teamMembers || project.data.info?.teamMembers ? <li><strong>Team members</strong>: {project.data.teamMembers || project.data.info?.teamMembers}</li> : null}
                      {project.data.position || project.data.info?.role ? <li><strong>Position</strong>: {project.data.position || project.data.info?.role}</li> : null}
                      {project.data.price || project.data.info?.price ? <li><strong>Price</strong>: {project.data.price || project.data.info?.price}</li> : null}
                      {project.data.tools || project.data.info?.tools ? <li><strong>Developing Tools</strong>: {project.data.tools || project.data.info?.tools}</li> : null}
                      {
                        project.data.websiteUrl ? (
                          <li>
                            <strong>Website</strong>: <a href={project.data.websiteUrl} target="_blank" rel="noreferrer">{project.data.websiteLabel || project.data.websiteUrl}</a>
                          </li>
                        ) : null
                      }
                      {
                        project.data.videoUrl ? (
                          <li>
                            <strong>Video Link</strong>: <a href={project.data.videoUrl} target="_blank" rel="noreferrer">{project.data.videoLabel || project.data.videoUrl}</a>
                          </li>
                        ) : null
                      }
                    </ul>
                  </div>
                </div>
              </div>

              {
                blocks.map((block, index) => (
                  <div
                    class={`row project-block${index === 0 ? " project-block--first" : ""}${index > 0 ? " project-block--after" : ""}${isMediaBlock(block) ? " project-block--media" : ""}${block.type === "decision" ? " project-block--decision" : ""}${block.type === "embed" ? " project-block--embed" : ""}${hasBlockTitle(block) && index > 0 ? " project-block--section" : ""}${index > 0 && isMediaBlock(blocks[index - 1]) && hasSubheading(block) ? " project-block--subheading-after-media" : ""}${isDisclaimer(block) ? " project-block--disclaimer" : ""}`}
                  >
                    <div class="col-12 col-lg-10 offset-lg-1 descrip-section" style="padding-top: 0; padding-bottom: 0;">
                      {block.title ? <h2 class="project-block__title">{block.title}</h2> : null}

                      {block.type === "paragraph" ? <RichText text={block.text} paragraphs={block.paragraphs} /> : null}

                      {
                        block.type === "decision" ? (
                          <article class="project-decision">
                            <div class="row g-4 align-items-center">
                              <div class={block.image ? "col-lg-7" : "col-12"}>
                                <p class="project-decision__label">{block.label}</p>
                                <p class="project-decision__question">{block.question}</p>
                                <h3 class="project-decision__title">{block.decision}</h3>
                                <RichText paragraphs={block.rationale} />
                                {
                                  block.outcome ? (
                                    <p class="project-decision__outcome"><strong>Why it matters</strong>{block.outcome}</p>
                                  ) : null
                                }
                              </div>
                              {
                                block.image ? (
                                  <div class="col-lg-5">
                                    <a class="project-decision__image-link" href={getAssetUrl(block.image.src)} data-glightbox="single">
                                      <img class="project-decision__image" src={getAssetUrl(block.image.src)} alt={block.image.alt || block.decision} />
                                    </a>
                                    {block.image.caption ? <p class="project-image-caption">{block.image.caption}</p> : null}
                                  </div>
                                ) : null
                              }
                            </div>
                          </article>
                        ) : null
                      }

                      {
                        block.type === "data-chart" ? (
                          <section class={`project-data-chart${block.compact ? " project-data-chart--compact" : ""}`} aria-label={block.title || block.eyebrow || "Project data"}>
                            {block.eyebrow ? <p class="project-data-chart__eyebrow">{block.eyebrow}</p> : null}
                            {block.description ? <p class="project-data-chart__description">{block.description}</p> : null}
                            <div class="project-data-chart__metrics">
                              {
                                block.metrics.map((metric) => (
                                  <div class="project-data-chart__metric">
                                    <div class="project-data-chart__metric-header">
                                      <span class="project-data-chart__value">{metric.value}</span>
                                      <span class="project-data-chart__label">{metric.label}</span>
                                    </div>
                                    {
                                      metric.progress !== undefined ? (
                                        <div
                                          class="project-data-chart__track"
                                          role="progressbar"
                                          aria-label={metric.label}
                                          aria-valuenow={metric.progress}
                                          aria-valuemin="0"
                                          aria-valuemax="100"
                                        >
                                          <span class="project-data-chart__bar" style={`width: ${metric.progress}%;`}></span>
                                        </div>
                                      ) : null
                                    }
                                    {metric.detail ? <p class="project-data-chart__detail">{metric.detail}</p> : null}
                                  </div>
                                ))
                              }
                            </div>
                            {
                              block.sourceLabel ? (
                                <p class="project-data-chart__source">
                                  Source: {block.sourceUrl ? <a href={block.sourceUrl} target="_blank" rel="noreferrer">{block.sourceLabel}</a> : block.sourceLabel}
                                </p>
                              ) : null
                            }
                            {block.note ? <p class="project-data-chart__note">{block.note}</p> : null}
                          </section>
                        ) : null
                      }

                      {
                        block.type === "workflow" ? (
                          <section class="project-workflow">
                            <div class="project-workflow__root">{block.root}</div>
                            <div class="project-workflow__connector" aria-hidden="true"></div>
                            <div class="project-workflow__items">
                              {
                                block.items.map((item) => (
                                  <article class="project-workflow__item">
                                    <div class="project-workflow__function">
                                      <h3>{item.title}</h3>
                                      <p>{item.description}</p>
                                    </div>
                                    <ol class="project-workflow__steps" aria-label={`${item.title} steps`}>
                                      {item.steps.map((step) => <li>{step}</li>)}
                                    </ol>
                                  </article>
                                ))
                              }
                            </div>
                          </section>
                        ) : null
                      }

                      {
                        block.type === "research-grid" ? (
                          <section class="project-research" aria-label={block.title || "Usability study"}>
                            {block.eyebrow ? <p class="project-research__eyebrow">{block.eyebrow}</p> : null}
                            <div class="project-research__setup">
                              <div>
                                <p class="project-research__label">Participants</p>
                                <p class="project-research__value">{block.participants}</p>
                              </div>
                              <div>
                                <p class="project-research__label">Methods</p>
                                <ul class="project-research__methods">
                                  {block.methods.map((method) => <li>{method}</li>)}
                                </ul>
                              </div>
                            </div>
                            {
                              block.pioneer ? (
                                <div class="project-research__evidence">
                                  <h3 class="project-research__subheading">{block.pioneer.title}</h3>
                                  <RichText paragraphs={block.pioneer.paragraphs} />
                                  <a class="project-research__image-link" href={getAssetUrl(block.pioneer.image.src)} data-glightbox="single">
                                    <img src={getAssetUrl(block.pioneer.image.src)} alt={block.pioneer.image.alt || project.data.title} />
                                  </a>
                                  {block.pioneer.image.caption ? <p class="project-image-caption">{block.pioneer.image.caption}</p> : null}
                                </div>
                              ) : null
                            }
                            {
                              block.output ? (
                                <div class="project-research__output">
                                  <a class="project-research__image-link" href={getAssetUrl(block.output.src)} data-glightbox="single">
                                    <img src={getAssetUrl(block.output.src)} alt={block.output.alt || project.data.title} />
                                  </a>
                                  {block.output.caption ? <p class="project-image-caption">{block.output.caption}</p> : null}
                                </div>
                              ) : null
                            }
                            {
                              block.testing ? (
                                <div class="project-research__testing">
                                  <h3 class="project-research__subheading">{block.testing.title}</h3>
                                  <RichText paragraphs={block.testing.paragraphs} />
                                </div>
                              ) : null
                            }
                            <div class="project-research__metrics">
                              {
                                block.metrics.map((metric) => (
                                  <div class="project-research__metric">
                                    <p class="project-research__metric-value">{metric.value}</p>
                                    <p class="project-research__metric-label">{metric.label}</p>
                                    {metric.detail ? <p class="project-research__metric-detail">{metric.detail}</p> : null}
                                  </div>
                                ))
                              }
                            </div>
                            {block.note ? <p class="project-research__note">{block.note}</p> : null}
                          </section>
                        ) : null
                      }

                      {
                        block.type === "interaction-grid" ? (
                          <section class="project-interaction-grid">
                            {block.intro ? <p class="project-interaction-grid__intro">{block.intro}</p> : null}
                            <div class="project-interaction-grid__items">
                              {
                                block.items.map((item) => (
                                  <article class="project-interaction-grid__item">
                                    <h3>{item.title}</h3>
                                    <p>{item.description}</p>
                                    <a href={getAssetUrl(item.image.src)} data-glightbox="single">
                                      <img src={getAssetUrl(item.image.src)} alt={item.image.alt || item.title} />
                                    </a>
                                    {item.image.caption ? <p class="project-image-caption">{item.image.caption}</p> : null}
                                  </article>
                                ))
                              }
                            </div>
                          </section>
                        ) : null
                      }

                      {
                        block.type === "image" ? (
                          <div>
                            <a href={getAssetUrl(block.image.src)} data-glightbox="single" style="display:block;cursor:zoom-in;">
                              <img
                                src={getAssetUrl(block.image.src)}
                                alt={block.image.alt || project.data.title}
                                style={getContentImageStyle(block.image.maxWidth)}
                              />
                            </a>
                            {block.image.caption ? <p class="project-image-caption">{block.image.caption}</p> : null}
                          </div>
                        ) : null
                      }

                      {
                        block.type === "image-grid" ? (
                          <div class="row" style="--bs-gutter-x: 2.75rem; --bs-gutter-y: 0;">
                            {
                              block.images.map((image) => (
                                <div class={getImageGridColumnClass(block.images.length)}>
                                  <a href={getAssetUrl(image.src)} data-glightbox="single" style="display:block;cursor:zoom-in;">
                                    <img
                                      src={getAssetUrl(image.src)}
                                      alt={image.alt || project.data.title}
                                      style={getContentImageStyle(image.maxWidth)}
                                    />
                                  </a>
                                  {image.caption ? <p class="project-image-caption">{image.caption}</p> : null}
                                </div>
                              ))
                            }
                          </div>
                        ) : null
                      }

                      {
                        block.type === "two-column" ? (
                          <div class="row gy-4">
                            <div class={getTwoColumnClasses(block.layout).left}>
                              {
                                block.left.kind === "text"
                                  ? <RichText text={block.left.text} paragraphs={block.left.paragraphs} />
                                  : block.left.kind === "data-chart" ? (
                                    <section class={`project-data-chart${block.left.compact ? " project-data-chart--compact" : ""}`} aria-label={block.left.eyebrow || "Project data"}>
                                      {block.left.description ? <p class="project-data-chart__description">{block.left.description}</p> : null}
                                      <div class="project-data-chart__metrics">
                                        {block.left.metrics.map((metric) => (
                                          <div class="project-data-chart__metric">
                                            <div class="project-data-chart__metric-header"><span class="project-data-chart__value">{metric.value}</span><span class="project-data-chart__label">{metric.label}</span></div>
                                            {metric.progress !== undefined ? <div class="project-data-chart__track" role="progressbar" aria-label={metric.label} aria-valuenow={metric.progress} aria-valuemin="0" aria-valuemax="100"><span class="project-data-chart__bar" style={`width: ${metric.progress}%;`}></span></div> : null}
                                            {metric.detail ? <p class="project-data-chart__detail">{metric.detail}</p> : null}
                                          </div>
                                        ))}
                                      </div>
                                      {block.left.sourceLabel ? <p class="project-data-chart__source">Source: {block.left.sourceUrl ? <a href={block.left.sourceUrl} target="_blank" rel="noreferrer">{block.left.sourceLabel}</a> : block.left.sourceLabel}</p> : null}
                                      {block.left.note ? <p class="project-data-chart__note">{block.left.note}</p> : null}
                                    </section>
                                  )
                                  : block.left.kind === "image-grid" ? (
                                    <div class="row" style="--bs-gutter-x: 1.75rem; --bs-gutter-y: 0;">
                                      {block.left.images.map((image) => (
                                        <div class={getImageGridColumnClass(block.left.images.length)}>
                                          <a href={getAssetUrl(image.src)} data-glightbox="single" style="display:block;cursor:zoom-in;">
                                            <img src={getAssetUrl(image.src)} alt={image.alt || project.data.title} style={getContentImageStyle(image.maxWidth)} />
                                          </a>
                                          {image.caption ? <p class="project-image-caption">{image.caption}</p> : null}
                                        </div>
                                      ))}
                                    </div>
                                  ) : (
                                    <>
                                      <a href={getAssetUrl(block.left.image.src)} data-glightbox="single" style="display:block;cursor:zoom-in;">
                                        <img src={getAssetUrl(block.left.image.src)} alt={block.left.image.alt || project.data.title} style={getContentImageStyle(block.left.image.maxWidth)} />
                                      </a>
                                      {block.left.image.caption ? <p class="project-image-caption">{block.left.image.caption}</p> : null}
                                    </>
                                  )
                              }
                            </div>
                            <div class={getTwoColumnClasses(block.layout).right}>
                              {
                                block.right.kind === "text"
                                  ? <RichText text={block.right.text} paragraphs={block.right.paragraphs} />
                                  : block.right.kind === "data-chart" ? (
                                    <section class={`project-data-chart${block.right.compact ? " project-data-chart--compact" : ""}`} aria-label={block.right.eyebrow || "Project data"}>
                                      {block.right.description ? <p class="project-data-chart__description">{block.right.description}</p> : null}
                                      <div class="project-data-chart__metrics">
                                        {block.right.metrics.map((metric) => (
                                          <div class="project-data-chart__metric">
                                            <div class="project-data-chart__metric-header"><span class="project-data-chart__value">{metric.value}</span><span class="project-data-chart__label">{metric.label}</span></div>
                                            {metric.progress !== undefined ? <div class="project-data-chart__track" role="progressbar" aria-label={metric.label} aria-valuenow={metric.progress} aria-valuemin="0" aria-valuemax="100"><span class="project-data-chart__bar" style={`width: ${metric.progress}%;`}></span></div> : null}
                                            {metric.detail ? <p class="project-data-chart__detail">{metric.detail}</p> : null}
                                          </div>
                                        ))}
                                      </div>
                                      {block.right.sourceLabel ? <p class="project-data-chart__source">Source: {block.right.sourceUrl ? <a href={block.right.sourceUrl} target="_blank" rel="noreferrer">{block.right.sourceLabel}</a> : block.right.sourceLabel}</p> : null}
                                      {block.right.note ? <p class="project-data-chart__note">{block.right.note}</p> : null}
                                    </section>
                                  )
                                  : block.right.kind === "image-grid" ? (
                                    <div class="row" style="--bs-gutter-x: 1.75rem; --bs-gutter-y: 0;">
                                      {block.right.images.map((image) => (
                                        <div class={getImageGridColumnClass(block.right.images.length)}>
                                          <a href={getAssetUrl(image.src)} data-glightbox="single" style="display:block;cursor:zoom-in;">
                                            <img src={getAssetUrl(image.src)} alt={image.alt || project.data.title} style={getContentImageStyle(image.maxWidth)} />
                                          </a>
                                          {image.caption ? <p class="project-image-caption">{image.caption}</p> : null}
                                        </div>
                                      ))}
                                    </div>
                                  ) : (
                                    <>
                                      <a href={getAssetUrl(block.right.image.src)} data-glightbox="single" style="display:block;cursor:zoom-in;">
                                        <img src={getAssetUrl(block.right.image.src)} alt={block.right.image.alt || project.data.title} style={getContentImageStyle(block.right.image.maxWidth)} />
                                      </a>
                                      {block.right.image.caption ? <p class="project-image-caption">{block.right.image.caption}</p> : null}
                                    </>
                                  )
                              }
                            </div>
                          </div>
                        ) : null
                      }

                      {
                        block.type === "quote" ? (
                          <blockquote style="border-left: 4px solid #20b38e; padding-left: 1rem; color: #444;">
                            <RichText text={block.text} paragraphs={block.paragraphs} />
                            {block.author ? <cite>{block.author}</cite> : null}
                          </blockquote>
                        ) : null
                      }

                      {
                        block.type === "embed" ? (
                          <div>
                            <div style="display: flex; justify-content: center; margin-top: 24px;">
                              <iframe
                                src={block.src}
                                width={block.width || "1000"}
                                height={block.height || "600"}
                                style="border: 1px solid rgba(0, 0, 0, 0.1); max-width: 100%;"
                                allowfullscreen
                              ></iframe>
                            </div>

                            {block.caption ? <p class="project-image-caption">{block.caption}</p> : null}
                          </div>
                        ) : null
                      }
                    </div>
                  </div>
                ))
              }

              {
                hasSupplementaryContent ? (
                  <div class="row">
                    <div class="col-12 col-lg-10 offset-lg-1 descrip-section">
                      <Content />
                    </div>
                  </div>
                ) : null
              }
            </div>
          </section>
    </>
  </main>

  <SiteFooter />

<style is:inline>
  .project-block--first {
    margin-top: 3rem;
  }

  .project-block--after {
    margin-top: 1.5rem;
  }

  .project-block--media {
    margin-top: 2rem;
  }

  .project-block--media + .project-block {
    margin-top: 2rem;
  }

  .project-block--media + .project-block--section {
    margin-top: 5rem;
  }

  .project-block--media + .project-block--subheading-after-media {
    margin-top: 4rem;
  }

  .project-block--media .descrip-section img {
    padding-top: 0;
  }

  .project-block .descrip-section > p:first-child {
    padding-top: 0;
  }

  .project-block .descrip-section > :last-child {
    margin-bottom: 0;
  }

  .project-image-caption {
    margin: 0.5rem 0 0;
    padding-top: 0 !important;
    color: #666;
    text-align: center;
    line-height: 1.4;
  }

  .project-block--section {
    margin-top: 5rem;
  }

  .project-block--subheading-after-media {
    margin-top: 4rem;
  }

  .project-block--disclaimer {
    margin-top: 5rem;
  }

  .project-block--embed {
    margin-top: 2.5rem;
  }

  .project-block--embed.project-block--section {
    margin-top: 5rem;
  }

  .project-block--decision {
    margin-top: 2.25rem;
  }

  .project-decision {
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border: 1px solid rgba(15, 23, 42, 0.12);
    border-radius: 1.25rem;
    background: linear-gradient(135deg, rgba(248, 250, 252, 0.96), rgba(255, 255, 255, 0.98));
    box-shadow: 0 14px 36px rgba(15, 23, 42, 0.06);
  }

  .project-decision p {
    padding-top: 0 !important;
  }

  .project-decision p + p {
    margin-top: 0.75rem;
  }

  .project-decision__label {
    margin: 0 0 0.65rem;
    color: #20b38e;
    font-size: 0.75rem;
