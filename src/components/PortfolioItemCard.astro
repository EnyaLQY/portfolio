---
interface Props {
  href: string;
  title: string;
  subtitle: string;
  topic: string;
  image: string;
  filters: string;
  previewHref?: string;
  previewTitle?: string;
}

const { href, title, subtitle, topic, image, filters, previewHref, previewTitle = "Preview" } = Astro.props;
---

<div class={`col-lg-4 col-md-6 portfolio-item ${filters}`}>
  <div class="portfolio-img">
    <a href={href} aria-label={`View project: ${title}`}>
      <img src={image} class="img-fluid" alt="" />
    </a>
    <div class="portfolio-topic" aria-label={`Project topic: ${topic}`}>{topic}</div>
  </div>

  <div class="portfolio-info">
    <h4>{title}</h4>
    <p>{subtitle}</p>
    {
      previewHref ? (
        <a href={previewHref} data-gall="portfolioGallery" class="venobox preview-link" aria-label={`Preview ${title}`} title={previewTitle}><i class="bx bx-plus" aria-hidden="true"></i></a>
      ) : null
    }
    <span class="details-link" aria-hidden="true"><i class="bx bx-link"></i></span>
  </div>
</div>
